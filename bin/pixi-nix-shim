#!/usr/bin/env bash
# Source: YONGHUNI/dotfiles/bin/pixi-nix-shim
set -Eeuo pipefail

fail() {
    printf 'pixi-nix-shim: %s\n' "$*" >&2
    exit 127
}

find_executable() {
    local name=$1 candidate
    shift

    if candidate=$(type -P "$name" 2>/dev/null); then
        printf '%s\n' "$candidate"
        return 0
    fi

    for candidate in "$@"; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

# Positron may launch with a smaller PATH than an interactive shell. Resolve
# required tools explicitly instead of embedding machine-specific Nix store
# paths or mutating the user's login environment.
nix_bin=$(find_executable nix \
    "$HOME/.local/bin/nix" \
    "$HOME/.nix-profile/bin/nix" \
    /usr/local/bin/nix \
    /usr/bin/nix) || fail 'nix executable not found'

realpath_bin=$(find_executable realpath \
    /usr/local/bin/realpath \
    /usr/bin/realpath \
    /bin/realpath) || fail 'realpath executable not found'
dirname_bin=$(find_executable dirname \
    /usr/local/bin/dirname \
    /usr/bin/dirname \
    /bin/dirname) || fail 'dirname executable not found'

# Canonicalize the working directory because Nix path inputs reject paths whose
# intermediate components are symlinks (for example ~/data -> /data/<user>).
project_dir=$(pwd -P)

# Positron commonly supplies --manifest-path when activating a discovered Pixi
# environment. Use it when present because the working directory need not be the
# project root.
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
        --manifest-path)
            if ((i + 1 >= ${#args[@]})); then
                printf 'pixi-nix-shim: --manifest-path requires a value\n' >&2
                exit 64
            fi
            manifest=${args[$((i + 1))]}
            if ! manifest=$($realpath_bin -- "$manifest" 2>/dev/null); then
                fail "cannot resolve manifest path: ${args[$((i + 1))]}"
            fi
            project_dir=$($dirname_bin -- "$manifest")
            break
            ;;
        --manifest-path=*)
            manifest=${args[$i]#--manifest-path=}
            [[ -n "$manifest" ]] || {
                printf 'pixi-nix-shim: --manifest-path requires a value\n' >&2
                exit 64
            }
            if ! manifest=$($realpath_bin -- "$manifest" 2>/dev/null); then
                fail "cannot resolve manifest path: ${args[$i]#--manifest-path=}"
            fi
            project_dir=$($dirname_bin -- "$manifest")
            break
            ;;
    esac
done

# The manifest may live below the flake root. Walk upward and use the nearest
# flake so every project controls the Pixi version exposed as its `pixi` app.
flake_root=$project_dir
while [[ ! -f "$flake_root/flake.nix" ]]; do
    [[ "$flake_root" != / ]] || fail "no flake.nix found from $project_dir upward"
    parent=$($dirname_bin -- "$flake_root")
    [[ "$parent" != "$flake_root" ]] || fail "no flake.nix found from $project_dir upward"
    flake_root=$parent
done
flake_root=$($realpath_bin -- "$flake_root")

# Fast path: realize the project-pinned Pixi package once and run its
# binary directly. App-only flakes fall back to the original nix run route
# (two runs, for version detection and execution).
if pixi_store=$("$nix_bin" build --no-link --print-out-paths "$flake_root#pixi" 2>/dev/null); then
    [[ -n "$pixi_store" && "$pixi_store" != *$'\n'* ]] || fail 'unexpected Pixi store path output'
    pixi_bin="$pixi_store/bin/pixi"
    [[ -x "$pixi_bin" ]] || fail "Pixi executable missing: $pixi_bin"
    pixi_command=("$pixi_bin")
else
    pixi_command=("$nix_bin" run "$flake_root#pixi" --)
fi

version_output=$("${pixi_command[@]}" --version) || fail 'could not determine Pixi version'
if [[ "$version_output" =~ ^pixi[[:space:]]+([0-9]+)\.([0-9]+)\. ]]; then
    major=${BASH_REMATCH[1]}
    minor=${BASH_REMATCH[2]}
else
    fail "unexpected Pixi version: $version_output"
fi

# Pixi < 0.69 accepts 'native', not 'system'. Pixi 0.68.1 on NixOS
# may supply 'system' even if the parent shell does not export it.
# Normalize only incompatible spellings; preserve explicit user choices
# such as webpki/all. Do not override newer Pixi's default when unset.
if (( major == 0 && minor < 69 )); then
    case "${PIXI_TLS_ROOT_CERTS:-}" in
        ''|system) export PIXI_TLS_ROOT_CERTS=native ;;
    esac
elif [[ "${PIXI_TLS_ROOT_CERTS:-}" == native ]]; then
    export PIXI_TLS_ROOT_CERTS=system
fi

# Do not enter nix develop: IDE-facing Pixi must not inherit the
# interactive development shell's activation variables.
exec "${pixi_command[@]}" "$@"
