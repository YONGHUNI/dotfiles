#!/usr/bin/env bash
# Source: YONGHUNI/dotfiles/bin/pixi-nix-shim
set -Eeuo pipefail

fail() {
    printf 'pixi-nix-shim: %s\n' "$*" >&2
    exit 127
}

find_executable() {
    local name=$1 candidate
    shift

    if candidate=$(type -P "$name" 2>/dev/null); then
        printf '%s\n' "$candidate"
        return 0
    fi

    for candidate in "$@"; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

# Positron may launch with a smaller PATH than an interactive shell. Resolve
# required tools explicitly instead of embedding machine-specific Nix store
# paths or mutating the user's login environment.
nix_bin=$(find_executable nix \
    "$HOME/.local/bin/nix" \
    "$HOME/.nix-profile/bin/nix" \
    /usr/local/bin/nix \
    /usr/bin/nix) || fail 'nix executable not found'

realpath_bin=$(find_executable realpath \
    /usr/local/bin/realpath \
    /usr/bin/realpath \
    /bin/realpath) || fail 'realpath executable not found'

dirname_bin=$(find_executable dirname \
    /usr/local/bin/dirname \
    /usr/bin/dirname \
    /bin/dirname) || fail 'dirname executable not found'

# Canonicalize the working directory because Nix path inputs reject paths whose
# intermediate components are symlinks (for example ~/data -> /data/<user>).
project_dir=$(pwd -P)

# Positron commonly supplies --manifest-path when activating a discovered Pixi
# environment. Use it when present because the working directory need not be the
# project root.
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
        --manifest-path)
            if ((i + 1 >= ${#args[@]})); then
                printf 'pixi-nix-shim: --manifest-path requires a value\n' >&2
                exit 64
            fi
            manifest=${args[$((i + 1))]}
            if ! manifest=$($realpath_bin -- "$manifest" 2>/dev/null); then
                fail "cannot resolve manifest path: ${args[$((i + 1))]}"
            fi
            project_dir=$($dirname_bin -- "$manifest")
            break
            ;;
        --manifest-path=*)
            manifest=${args[$i]#--manifest-path=}
            [[ -n "$manifest" ]] || {
                printf 'pixi-nix-shim: --manifest-path requires a value\n' >&2
                exit 64
            }
            if ! manifest=$($realpath_bin -- "$manifest" 2>/dev/null); then
                fail "cannot resolve manifest path: ${args[$i]#--manifest-path=}"
            fi
            project_dir=$($dirname_bin -- "$manifest")
            break
            ;;
    esac
done

# The manifest may live below the flake root. Walk upward and use the nearest
# flake so every project controls the Pixi version provided by its devShell.
flake_root=$project_dir
while [[ ! -f "$flake_root/flake.nix" ]]; do
    [[ "$flake_root" != / ]] || fail "no flake.nix found from $project_dir upward"
    parent=$($dirname_bin -- "$flake_root")
    [[ "$parent" != "$flake_root" ]] || fail "no flake.nix found from $project_dir upward"
    flake_root=$parent
done
flake_root=$($realpath_bin -- "$flake_root")

# Remove this shim's directory before entering the devShell. This prevents
# `nix develop -c pixi` from ever resolving back to the shim itself. No
# persistent recursion marker is used, so the command also works normally from
# a terminal that Positron has already activated as a Pixi environment.
shim_dir=$(cd "$($dirname_bin -- "${BASH_SOURCE[0]}")" && pwd -P)
clean_path=""
IFS=: read -r -a path_entries <<< "${PATH:-}"
for path_entry in "${path_entries[@]}"; do
    [[ -n "$path_entry" ]] || continue
    [[ "$path_entry" == "$shim_dir" || "$path_entry" == "$HOME/.pixi/bin" ]] && continue

    if [[ -z "$clean_path" ]]; then
        clean_path=$path_entry
    else
        clean_path+=":$path_entry"
    fi
done
[[ -n "$clean_path" ]] || fail 'PATH became empty after removing the shim directory'

export PATH="$clean_path"
unset PIXI_NIX_SHIM_ACTIVE 2>/dev/null || true

# Resolve Pixi *inside* the project's Nix devShell, and require the executable
# to come from the Nix store. This prevents an unrelated host/global Pixi from
# silently taking over when a project's flake forgot to provide Pixi.
exec "$nix_bin" develop "$flake_root" -c bash -c '
    pixi_bin=$(type -P pixi 2>/dev/null || true)

    if [[ -z "$pixi_bin" ]]; then
        echo "pixi-nix-shim: project devShell does not provide pixi" >&2
        exit 127
    fi

    case "$pixi_bin" in
        /nix/store/*/bin/pixi)
            ;;
        *)
            echo "pixi-nix-shim: refusing non-Nix Pixi: $pixi_bin" >&2
            exit 126
            ;;
    esac

    exec "$pixi_bin" "$@"
' pixi-nix-shim "$@"
